# ─────────────────────────────────────────────────────────────────────────────
# Norrköpingskartan — miljövariabler
#
# Kopiera till `.env` lokalt. `.env` är git-ignorerad och får ALDRIG checkas in.
# Utan `.env` startar appen i fallback-läge (FK-33): OSM-bakgrund + utvecklingsbanner.
#
# Variabler med prefix VITE_ hamnar i klientbundlen. Lägg ALDRIG en hemlighet där (A2, NFK-15).
# ─────────────────────────────────────────────────────────────────────────────

# ── Klient (publika, hamnar i bundlen) ──────────────────────────────────────
# Bakgrundskartan (topografisk) är självhostad (data/derived/topowebb-farg.pmtiles, ADR-09)
# och behöver ingen inställning alls. VITE_LM_ENABLED gäller bara det som går via
# edge-proxyn med Lantmäteriets appkonto (flygbild, live-WMTS): sätt till "true" när
# `npm run dev:netlify` körs med LM_USER/LM_PASSWORD, eller på preview/prod.
VITE_LM_ENABLED=

# ── Edge-funktioner (endast server, läses av netlify/functions/*) ──────────
# Lantmäteriets appkonto från Geotorget (format: fyra bokstäver + fyra siffror, t.ex. abcd0001).
# Används för HTTP Basic-autentisering mot visningstjänsterna.
LM_USER=
LM_PASSWORD=

# Alternativ: om tjänsten i stället kräver OAuth2-bearer, sätt token här (ej samtidigt som ovan).
LM_BEARER_TOKEN=

# WMTS-mallar. {z}/{y}/{x} ersätts av proxyn. Verifiera mot Geotorgets tekniska beskrivning (JK-07).
LM_TOPOWEBB_TEMPLATE=https://maps.lantmateriet.se/topowebb/v1.1/wmts/1.0.0/topowebb/default/3006/{z}/{y}/{x}.png
LM_ORTOFOTO_TEMPLATE=https://maps.lantmateriet.se/ortofoto/v1.1/wmts/1.0.0/Ortofoto_0.5/default/3006/{z}/{y}/{x}.png

# Tillåtna zoomnivåer i proxyn (NFK-18). LM:s 3006-matris har nivå 0–15.
TILES_ZOOM_MIN=0
TILES_ZOOM_MAX=14

# Kommaseparerade värdar som får anropa proxyn (Origin/Referer-lås, NFK-18).
# localhost och *.netlify.app-previews läggs till automatiskt när CONTEXT != production.
TILES_ALLOWED_HOSTS=arenm.se,www.arenm.se
