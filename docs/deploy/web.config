<?xml version="1.0" encoding="utf-8"?>
<!--
  Mall för drift av Norrköpingskartans statiska bygge (dist/) på IIS 10+.
  Speglar netlify.toml. Kräver IIS-modulen "URL Rewrite". Se docs/deploy/iis.md.
  INTE i bruk på Netlify — ligger utanför public/ och deployas inte.
-->
<configuration>
  <system.webServer>

    <!-- MIME-typer som IIS inte känner till: utan dessa blir kartdata 404. -->
    <staticContent>
      <remove fileExtension=".json" />
      <mimeMap fileExtension=".json" mimeType="application/json; charset=utf-8" />
      <remove fileExtension=".geojson" />
      <mimeMap fileExtension=".geojson" mimeType="application/geo+json; charset=utf-8" />
      <remove fileExtension=".pmtiles" />
      <mimeMap fileExtension=".pmtiles" mimeType="application/octet-stream" />
      <remove fileExtension=".pbf" />
      <mimeMap fileExtension=".pbf" mimeType="application/x-protobuf" />
      <remove fileExtension=".svg" />
      <mimeMap fileExtension=".svg" mimeType="image/svg+xml" />
      <remove fileExtension=".webmanifest" />
      <mimeMap fileExtension=".webmanifest" mimeType="application/manifest+json" />
      <!-- Standard för allt som inte får en specifik regel nedan: validera mot ETag (NFK-04). -->
      <clientCache cacheControlMode="UseMaxAge" cacheControlMaxAge="0.00:00:00" />
    </staticContent>

    <!-- Komprimering (Netlify gör detta automatiskt). -->
    <urlCompression doStaticCompression="true" doDynamicCompression="true" />
    <httpCompression>
      <staticTypes>
        <add mimeType="application/json" enabled="true" />
        <add mimeType="application/geo+json" enabled="true" />
        <add mimeType="text/*" enabled="true" />
        <add mimeType="application/javascript" enabled="true" />
        <add mimeType="image/svg+xml" enabled="true" />
        <add mimeType="*/*" enabled="false" />
      </staticTypes>
    </httpCompression>

    <!-- Säkerhetsheaders (NFK-17). CSP:n ligger i varje HTML-sida som <meta>; headern bär frame-ancestors. -->
    <httpProtocol>
      <customHeaders>
        <remove name="X-Powered-By" />
        <add name="Content-Security-Policy" value="frame-ancestors 'none'" />
        <add name="Strict-Transport-Security" value="max-age=31536000; includeSubDomains" />
        <add name="X-Content-Type-Options" value="nosniff" />
        <add name="Referrer-Policy" value="strict-origin-when-cross-origin" />
        <add name="Permissions-Policy" value="geolocation=(self), camera=(), microphone=(), payment=(), usb=(), interest-cohort=()" />
        <add name="X-Frame-Options" value="DENY" />
        <add name="Cross-Origin-Opener-Policy" value="same-origin" />
      </customHeaders>
    </httpProtocol>

    <!-- Request-filtrering: servera aldrig konfigurations- eller miljöfiler. -->
    <security>
      <requestFiltering>
        <fileExtensions>
          <add fileExtension=".env" allowed="false" />
          <add fileExtension=".config" allowed="false" />
        </fileExtensions>
        <requestLimits maxUrl="2048" maxQueryString="2048" />
      </requestFiltering>
    </security>

    <rewrite>
      <rules>
        <!-- https-tvång -->
        <rule name="HTTPS" stopProcessing="true">
          <match url="(.*)" />
          <conditions><add input="{HTTPS}" pattern="off" ignoreCase="true" /></conditions>
          <action type="Redirect" url="https://{HTTP_HOST}/{R:1}" redirectType="Permanent" />
        </rule>
        <!-- Rot → sajtens bas -->
        <rule name="Root" stopProcessing="true">
          <match url="^$" />
          <action type="Redirect" url="/projekt/norrkoping/" redirectType="Permanent" />
        </rule>
        <!-- Verktygssidan kräver avslutande snedstreck (relativa sökvägar) -->
        <rule name="VerktygSlash" stopProcessing="true">
          <match url="^projekt/norrkoping/verktyg$" />
          <action type="Redirect" url="/projekt/norrkoping/verktyg/" redirectType="Permanent" />
        </rule>
        <!-- Saknad datafil ska ge 404, inte SPA-HTML -->
        <rule name="DataMissing" stopProcessing="true">
          <match url="^projekt/norrkoping/(data|vendor)/.*" />
          <conditions><add input="{REQUEST_FILENAME}" matchType="IsFile" negate="true" /></conditions>
          <action type="CustomResponse" statusCode="404" statusReason="Not Found" statusDescription="Filen finns inte" />
        </rule>
        <!-- SPA-fallback för djuplänkar (NFK-32 tills sidor förrenderas) -->
        <rule name="SPA" stopProcessing="true">
          <match url="^projekt/norrkoping/.*" />
          <conditions>
            <add input="{REQUEST_FILENAME}" matchType="IsFile" negate="true" />
            <add input="{REQUEST_FILENAME}" matchType="IsDirectory" negate="true" />
          </conditions>
          <action type="Rewrite" url="/projekt/norrkoping/index.html" />
        </rule>
      </rules>
      <!-- Cache per katalog (motsvarar [[headers]] i netlify.toml) -->
      <outboundRules>
        <rule name="CacheAssets" preCondition="IsAssets">
          <match serverVariable="RESPONSE_Cache-Control" pattern=".*" />
          <action type="Rewrite" value="public, max-age=31536000, immutable" />
        </rule>
        <rule name="CacheVendor" preCondition="IsVendor">
          <match serverVariable="RESPONSE_Cache-Control" pattern=".*" />
          <action type="Rewrite" value="public, max-age=2592000, immutable" />
        </rule>
        <rule name="CacheData" preCondition="IsData">
          <match serverVariable="RESPONSE_Cache-Control" pattern=".*" />
          <action type="Rewrite" value="public, max-age=86400, stale-while-revalidate=604800" />
        </rule>
        <preConditions>
          <preCondition name="IsAssets"><add input="{REQUEST_URI}" pattern="^/projekt/norrkoping/assets/" /></preCondition>
          <preCondition name="IsVendor"><add input="{REQUEST_URI}" pattern="^/projekt/norrkoping/vendor/" /></preCondition>
          <preCondition name="IsData"><add input="{REQUEST_URI}" pattern="^/projekt/norrkoping/data/" /></preCondition>
        </preConditions>
      </outboundRules>
    </rewrite>

  </system.webServer>
</configuration>
